"""Module definition for Tink C++ GCP KMS Examples."""

# Omitting `version` because this is not meant to be depended on by other modules.
module(name = "tink_cc_examples")

bazel_dep(
    name = "tink_cc_gcpkms",
)
local_path_override(
    module_name = "tink_cc_gcpkms",
    path = "../",
)

bazel_dep(
    name = "tink_cc",
    version = "2.7.0",
)
bazel_dep(
    name = "rules_cc",
    version = "0.2.11",
)
bazel_dep(
    name = "rules_shell",
    version = "0.8.0",
)
bazel_dep(
    name = "googletest",
    version = "1.17.0",
)
bazel_dep(
    name = "abseil-cpp",
    version = "20260526.0",
)
bazel_dep(
    name = "grpc",
    version = "1.81.1",
)
single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = [
        "//:patches/grpc_address_sorting_fix.patch",
        "//:patches/grpc_xxhash_fix.patch",
        "//:patches/grpc_build_system_fix.patch",
    ],
    version = "1.81.1",
)

single_version_override(
    module_name = "c-ares",
    patch_strip = 1,
    patches = [
        "//:patches/c-ares_bazel9.patch",
    ],
    version = "1.34.6",
)


single_version_override(
    module_name = "google_cloud_cpp",
    patch_strip = 1,
    patches = [
        "//:patches/google_cloud_cpp.patch",
        "//:patches/google_cloud_cpp_gapic.patch",
        "//:patches/google_cloud_cpp_cloud.patch",
        "//:patches/google_cloud_cpp_capture_build_info.patch",
    ],
    version = "3.0.0-rc1",
)
